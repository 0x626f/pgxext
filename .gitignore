# Hidden directories at any depth (dotfiles remain covered separately).
**/.*/
!/.codex/
!/.codex/skills/
!/.codex/skills/design-backend-module/
!/.codex/skills/design-backend-module/**

# Environment files
.env
.env.*
!.env.example
!*.env.example
*.env
!/backend/infra.example.env

# Application-local structured configuration (tracked examples live in docs/)
/backend/cmd/**/*.toml
/backend/cmd/**/*.yaml
/backend/cmd/**/*.yml
!/backend/cmd/**/docs/*.toml
!/backend/cmd/**/docs/*.yaml
!/backend/cmd/**/docs/*.yml
!/backend/cmd/**/docs/**/*.toml
!/backend/cmd/**/docs/**/*.yaml
!/backend/cmd/**/docs/**/*.yml

# Solerk application-local environment configuration
/backend/cmd/solerk/.env*
/backend/cmd/solerk/*.env
!/backend/cmd/solerk/docs/.env*
!/backend/cmd/solerk/docs/*.env

# Go build artifacts
/.build/
/evm
**/bin/
**/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go workspace files
go.work
go.work.sum

# Coverage and profiling
coverage.out
*.coverprofile
*.prof

# Dependency/vendor caches
**/vendor/

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
